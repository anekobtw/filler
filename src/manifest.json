{
  "manifest_version": 3,
  "name": "Resume Filler",
  "version": "0.1.0",
  "description": "Fills common resume form fields from a local configuration file when requested.",
  "browser_specific_settings": {
    "gecko": {
      "id": "resume-filler@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "webNavigation", "scripting", "cookies"],
  "host_permissions": ["http://127.0.0.1/*", "https://*.linkedin.com/*"],
  "action": {
    "default_title": "Resume Filler",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["assoc-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
